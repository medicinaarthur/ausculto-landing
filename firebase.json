{
  "_comment": "Dois sites, dois targets EXPLICITOS. 'site' e a landing principal existente (auscultoapp.com) e permanece byte a byte com o comportamento observado ao vivo em 2026-08-21 — a unica mudanca e o 'ignore' endurecido e o predeploy de guarda, ambos estritamente para impedir publicacao acidental. 'enamed' e o site novo e isolado, que publica SOMENTE o artefato gerado por scripts/build-enamed.mjs. Nenhum dos dois blocos faz deploy de Cloud Functions: o rewrite de /_bridge/appstore-click apenas CONSOME a function recordAppStoreClick, administrada pelo repositorio do app.",
  "hosting": [
    {
      "target": "site",
      "public": ".",
      "predeploy": [
        "node scripts/guard-site-deploy.mjs"
      ],
      "ignore": [
        "firebase.json",
        "**/.*",
        "**/node_modules/**",
        "package.json",
        "package-lock.json",
        "DEPLOY-CONFIG-README.md",
        "*.log",
        "firebase-debug.log",
        "firestore-debug.log",
        "ui-debug.log",
        "skills-lock.json",
        "dist/**",
        "scripts/**",
        "enamed/**",
        "qa-*.png"
      ],
      "rewrites": [
        {
          "source": "/_bridge/appstore-click",
          "function": "recordAppStoreClick"
        }
      ],
      "headers": [
        {
          "source": "**/*.html",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            }
          ]
        },
        {
          "source": "**/*.@(css|js)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=3600, must-revalidate"
            }
          ]
        },
        {
          "source": "**/*.@(png|jpg|jpeg|webp|avif|gif|svg|ico)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=86400"
            }
          ]
        },
        {
          "source": "**/*.@(woff|woff2|ttf|otf)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=86400"
            }
          ]
        }
      ]
    },
    {
      "target": "enamed",
      "public": "dist/enamed",
      "ignore": [
        "**/.*",
        "**/node_modules/**"
      ],
      "cleanUrls": false,
      "trailingSlashBehavior": "ADD",
      "headers": [
        {
          "source": "**",
          "headers": [
            {
              "key": "Content-Security-Policy",
              "value": "default-src 'self'; script-src 'self' 'unsafe-inline' https://connect.facebook.net; style-src 'self' 'unsafe-inline'; img-src 'self' data: https://www.facebook.com; media-src 'self'; font-src 'self'; connect-src 'self' https://www.facebook.com https://connect.facebook.net; frame-src 'none'; object-src 'none'; frame-ancestors 'none'; base-uri 'self'; form-action 'none'"
            },
            {
              "key": "X-Content-Type-Options",
              "value": "nosniff"
            },
            {
              "key": "X-Frame-Options",
              "value": "DENY"
            },
            {
              "key": "Referrer-Policy",
              "value": "strict-origin-when-cross-origin"
            },
            {
              "key": "Permissions-Policy",
              "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), interest-cohort=()"
            },
            {
              "key": "Strict-Transport-Security",
              "value": "max-age=31536000; includeSubDomains"
            },
            {
              "key": "Cross-Origin-Opener-Policy",
              "value": "same-origin"
            },
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            }
          ]
        },
        {
          "source": "**/*.html",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            }
          ]
        },
        {
          "source": "/release-manifest.json",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "no-cache, no-store, must-revalidate"
            }
          ]
        },
        {
          "source": "**/*.@(css|js)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=3600, must-revalidate"
            }
          ]
        },
        {
          "source": "**/*.@(png|jpg|jpeg|webp|avif|gif|svg|ico|mp4)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        },
        {
          "source": "**/*.@(woff|woff2|ttf|otf)",
          "headers": [
            {
              "key": "Cache-Control",
              "value": "public, max-age=31536000, immutable"
            }
          ]
        }
      ]
    }
  ]
}
