# Logs de ferramenta. O firebase-debug.log tem 1,2 MB e carrega o inventario
# completo de Cloud Functions, o appId do projeto, e-mails de service account e
# os NOMES dos secrets do Secret Manager. Ele nunca pode ser versionado nem
# publicado (ver tambem o "ignore" do firebase.json).
*.log
firebase-debug.log
firestore-debug.log
ui-debug.log

# Artefato de build: gerado por scripts/build-enamed.mjs, nunca editado a mao.
dist/

# Dependencias e caches
node_modules/
.cache/
.parcel-cache/

# Ferramental de agente (nao faz parte do site publicado)
.impeccable/

# Sistema
.DS_Store
Thumbs.db

# Cache do Firebase CLI. `.firebase/hosting.*.cache` guarda o inventario de
# arquivos do ultimo deploy — e regenerado a cada publicacao e nao descreve o
# site, descreve a maquina que publicou.
.firebase/

# Ferramental de agente. Nao faz parte do site, e o `ignore` do firebase.json
# ja o exclui do deploy; faltava exclui-lo do git.
.agents/
.claude/
skills-lock.json
