{
  "projects": {
    "default": "auscultoapp"
  },
  "targets": {
    "auscultoapp": {
      "hosting": {
        "site": [
          "auscultoapp"
        ],
        "enamed": [
          "auscultoapp-enamed"
        ],
        "parceiros": [
          "auscultoapp-parceiros"
        ]
      }
    }
  },
  "etags": {},
  "_comment": "Targets EXPLICITOS. Sem eles, 'firebase deploy' publica no site default do projeto (auscultoapp = auscultoapp.com, producao). Com eles, cada site pode ser publicado isoladamente com --only hosting:<target>. O target parceiros aponta somente para auscultoapp-parceiros."
}
