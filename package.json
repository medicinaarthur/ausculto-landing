{
  "name": "ausculto-landing",
  "version": "1.0.0",
  "private": true,
  "description": "Ausculto marketing site — static Academy, ENAMED and public content builds.",
  "scripts": {
    "serve": "npx --yes serve .",
    "check:js": "node --check meta_tracking.js && node --check assets/js/main.js && node --check assets/js/enamed.js && node --check scripts/build-enamed.mjs && node --check scripts/guard-site-deploy.mjs && node --check scripts/test-tracking-contract.mjs && node --check parceiros/public/app.js && node --check parceiros/public/coupon_ui.js && node --check parceiros/scripts/validate_repository.cjs && node --check parceiros/scripts/test_coupon_ui.mjs",
    "check:html": "npx --yes html-validate \"**/*.html\"",
    "check:format": "npx --yes prettier --check \"**/*.{html,css,js,json,md}\"",
    "qa:links": "npx --yes broken-link-checker http://localhost:3000 -ro",
    "qa:lighthouse": "npx --yes lighthouse http://localhost:3000 --chrome-flags=\"--headless\"",
    "qa:axe": "npx --yes axe http://localhost:3000",
    "qa:shots": "npx --yes playwright screenshot --viewport-size=1280,800 http://localhost:3000 qa-home.png",
    "build:enamed": "node scripts/build-enamed.mjs",
    "verify:enamed": "node scripts/build-enamed.mjs --verify",
    "deploy:enamed:preview": "npm run test:tracking && npm run build:enamed && firebase hosting:channel:deploy qa --config firebase.preview.json --only enamed --project auscultoapp --expires 7d",
    "serve:enamed": "npm run build:enamed && npx --yes serve dist/enamed",
    "serve:parceiros": "node parceiros/scripts/serve_local.cjs",
    "verify:parceiros": "node parceiros/scripts/validate_repository.cjs && node parceiros/scripts/test_coupon_ui.mjs",
    "verify:partner-qr": "npm --prefix parceiros run verify:qr",
    "test:tracking": "node scripts/test-tracking-contract.mjs",
    "build:site": "node scripts/build-site.mjs",
    "verify:site": "node scripts/build-site.mjs --verify",
    "test:academy-content": "node --test scripts/test-academy-articles.mjs",
    "build:enamed-continuous": "node scripts/build-enamed-continuous.mjs",
    "verify:enamed-continuous": "node scripts/build-enamed-continuous.mjs --verify",
    "test:enamed-continuous": "node scripts/test-enamed-continuous.mjs",
    "export:academy-presentation": "node scripts/export-academy-presentation.mjs",
    "build:academy-preview": "node scripts/render-enamed-source.mjs && node scripts/build-site.mjs && node scripts/build-enamed-continuous.mjs && node scripts/build-academy-preview.mjs",
    "test:academy-presentation": "node --test scripts/test-academy-presentation.mjs",
    "test:site-lapidacao": "node --test scripts/test-academy-export.mjs scripts/test-site-facts.mjs scripts/test-academy-catalogue.mjs scripts/test-academy-reader.mjs scripts/test-academy-sim-demo.mjs scripts/test-academy-presentation.mjs scripts/test-academy-illustrations.mjs scripts/test-site-artifact.mjs",
    "test:site-runtime": "node scripts/test-site-runtime.mjs",
    "test:site-correction": "node --test scripts/test-academy-sim-demo.mjs scripts/test-academy-corrections.mjs scripts/test-academy-study.mjs scripts/test-academy-figure-correction.mjs scripts/test-home-correction.mjs",
    "test:site-correction-runtime": "node scripts/test-site-correction-runtime.mjs",
    "prepare:home-hero": "node scripts/prepare-home-hero-assets.mjs",
    "test:home-hero": "node --test scripts/test-home-hero.mjs",
    "test:home-hero-runtime": "node scripts/test-home-hero-runtime.mjs",
    "test:academy-dossier": "node --test scripts/test-academy-dossier.mjs",
    "test:academy-dossier-runtime": "node scripts/test-academy-dossier-runtime.mjs",
    "prepare:academy-dossier-assets": "node scripts/prepare-academy-dossier-assets.mjs",
    "prepare:academy-practice": "node scripts/prepare-academy-practice.mjs",
    "prepare:academy-dossier-prints": "node scripts/prepare-academy-dossier-prints.mjs",
    "test:academy-paths": "node --test scripts/test-academy-paths.mjs scripts/test-academy-bank-counts.mjs",
    "test:academy-paths-runtime": "node scripts/test-academy-paths-runtime.mjs",
    "prepare:academy-paths": "node scripts/prepare-academy-paths-assets.mjs",
    "audit:academy-banks": "node scripts/export-academy-bank-counts.mjs"
  },
  "dependencies": {
    "@phosphor-icons/core": "2.1.1",
    "markdown-it": "15.0.2"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "lighthouse": "^13.5.0",
    "playwright": "1.63.0",
    "sharp": "^0.35.4"
  }
}
